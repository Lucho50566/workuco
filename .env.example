# Puerto del servidor (Render inyecta el suyo)
PORT=4250

# Carpeta de datos (por defecto ./data)
# WORKUCO_DATA=/ruta/a/data

# URL pública (para sitemap y cookies seguras)
# PUBLIC_URL=https://workuco.onrender.com

# Administrador
WORKUCO_ADMIN_EMAIL=admin@workuco.com.ar
WORKUCO_ADMIN_PASS=cambiame-por-una-clave-larga

# Carga ofertas y postulaciones de ejemplo si la base está vacía
# WORKUCO_DEMO=1
